# Copy to .env before `docker compose up --build`. Never commit .env.

# Required: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# true creates demo@subwatch.dev / Demo1234! (8 subscriptions). Use false in real deployments.
SEED_DEMO=true

# Origin(s) of the frontend, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:4200
